# Root environment reference for the Print Queue App monorepo.
# Copy the relevant values into apps/web/.env.local and apps/bridge/.env
# See apps/web/.env.example and apps/bridge/.env.example for the authoritative per-app lists.

# --- Supabase project (shared source of truth) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Web app public URL ---
APP_URL=http://localhost:3000
