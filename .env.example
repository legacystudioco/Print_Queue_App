# Root environment reference for the Print Queue App monorepo.
# Copy the relevant values into apps/web/.env.local and apps/bridge/.env
# See apps/web/.env.example and apps/bridge/.env.example for the authoritative per-app lists.
#
# Naming: this project standardizes on Supabase's current API-key scheme
# (publishable/secret), not the legacy anon/service_role names. Both are
# accepted by the Supabase SDK — this project only supports one, on purpose.
# See docs/setup-supabase.md.

# --- Supabase project (shared source of truth) ---
# Project base URL only — no /rest/v1 or other path suffix.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Web app public URL ---
APP_URL=http://localhost:3000

# --- Push notifications ---
# VAPID keys + NOTIFY_WEBHOOK_SECRET are only in apps/web/.env.example (the
# private key must never reach the bridge or the browser) and
# NOTIFY_WEBHOOK_SECRET is duplicated into apps/bridge/.env.example (the
# bridge only needs the shared secret, not the VAPID keys themselves) — see
# docs/push-notifications.md.
