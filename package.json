{
  "name": "print-queue-app",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "pnpm --filter web db:types",
    "db:seed": "tsx scripts/seed.ts",
    "bridge:dev": "pnpm --filter bridge dev",
    "bridge:start": "pnpm --filter bridge start"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@supabase/supabase-js": "^2.47.10",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
