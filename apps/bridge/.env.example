# Copy to .env for local development. This runs on a machine on your home
# network, never on Vercel — it is the only place printer credentials live.
#
# Naming: standardized on Supabase's current API-key scheme
# (publishable/secret) rather than the legacy anon/service_role names —
# see docs/setup-supabase.md.

# Supabase — secret key required (the bridge bypasses RLS by design;
# see docs/security.md for why that's safe here).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Identifies this machine to the bridge supervisor — it starts one worker
# for every enabled printers row whose bridge_id matches this value (see
# runtime/BridgeSupervisor.ts), so a single bridge host can run several
# physical printers of different brands concurrently. Adding a second
# printer to an existing bridge host does NOT require changing this value —
# migration 0016 assigns the new printer to whatever bridge_id the existing
# printer row(s) already use, so keep whatever this was already set to.
BRIDGE_ID=home-bridge-1

# mock | bambu | snapmaker | flashforge — 'mock' overrides every printer row
# to use the simulator; any other value is only checked for typos, since
# adapter selection is actually driven by each printer row's `brand` column
# (see printers/factory.ts). See docs/bambu-integration.md /
# docs/flashforge-integration.md before switching off mock.
PRINTER_ADAPTER=mock

# Bambu P1S connection (only used for a printer row whose brand is 'bambu').
# Leave blank until physical printer integration — do not invent values here.
BAMBU_PRINTER_IP=
BAMBU_PRINTER_SERIAL=
BAMBU_ACCESS_CODE=
BAMBU_DEVICE_NAME=P1S

# auto | manual | auto_with_manual_fallback — see docs/bambu-integration.md
# ("Living with ACS without touching printer settings"). Current Bambu
# firmware's Access Control System silently rejects the MQTT start command
# while the printer is in Cloud Mode (not LAN-only + Developer Mode); the
# default here treats a successful FTPS upload as a real outcome instead of
# failing the job every time that happens.
BAMBU_PRINT_START_MODE=auto_with_manual_fallback

# Flashforge Adventurer 5M connection (only used for a printer row whose
# brand is 'flashforge'). Leave blank until physical printer integration —
# do not invent values here.
#
# FLASHFORGE_ACCESS_CODE is the LAN "Check Code" (sometimes labeled "Verify
# Code") used to authenticate local HTTP API requests. This is NOT the same
# as the FlashCloud/"Flash Code" registration code shown for cloud account
# binding (that one is unrelated to LAN control and is never used by this
# bridge). See docs/flashforge-integration.md ("Credential disambiguation")
# for exactly where to find the Check Code on this printer's firmware.
FLASHFORGE_HOST=
FLASHFORGE_PORT=8898
FLASHFORGE_SERIAL_NUMBER=
FLASHFORGE_ACCESS_CODE=
FLASHFORGE_REQUEST_TIMEOUT_MS=10000
FLASHFORGE_UPLOAD_TIMEOUT_MS=120000
# auto | manual | auto_with_manual_fallback — same semantics as
# BAMBU_PRINT_START_MODE, but /printGcode gives an unambiguous
# success/failure response (unlike Bambu's fire-and-forget MQTT), so 'auto'
# is a safe default.
FLASHFORGE_PRINT_START_MODE=auto

# Timing.
COMMAND_POLL_INTERVAL_MS=3000
HEARTBEAT_INTERVAL_MS=20000

# Where downloaded .gcode.3mf files are staged before upload to the printer.
TEMP_DIRECTORY=./tmp

LOG_LEVEL=info

# Push notifications (optional — see docs/push-notifications.md). When a
# print completes, the bridge records it in Supabase and then pokes
# {APP_URL}/api/notifications/dispatch to ask the web app to actually send
# push notifications. The bridge never holds VAPID keys. Leave both blank
# to disable dispatch entirely — completions are still recorded, just never
# pushed to anyone.
APP_URL=
NOTIFY_WEBHOOK_SECRET=
