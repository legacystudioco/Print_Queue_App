# Copy to .env.local for local development.
# On Vercel, set these as Project Environment Variables instead.
#
# Naming: standardized on Supabase's current API-key scheme
# (publishable/secret) rather than the legacy anon/service_role names —
# see docs/setup-supabase.md.

# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Used by route handlers / server actions to bypass RLS for privileged
# operations (creating jobs, issuing printer commands, signed URLs).
SUPABASE_SECRET_KEY=

# Public URL this app is deployed at (used in a few absolute-URL contexts).
# In production/Vercel, set this to the real deployment URL, not localhost.
APP_URL=http://localhost:3000

# Only needed when running `pnpm db:types` locally.
# SUPABASE_PROJECT_ID=your-project-ref

# --- Web Push (see docs/push-notifications.md) ---
#
# Generate a VAPID key pair once per project with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose in the browser (it's how the browser
# verifies push messages really came from this server) — the private key
# is not; it must never gain a NEXT_PUBLIC_ prefix or reach the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI the push services can reach you at if they need to (spec
# requires either a mailto: or an https: URL) — see docs/push-notifications.md.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the bridge sends on POST /api/notifications/dispatch — must
# match the bridge's NOTIFY_WEBHOOK_SECRET exactly. Generate with
# `openssl rand -hex 32` or similar; treat it like a password.
NOTIFY_WEBHOOK_SECRET=
