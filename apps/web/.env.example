# Copy to .env.local for local development.
# On Vercel, set these as Project Environment Variables instead.

# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Used by route handlers / server actions to bypass RLS for privileged
# operations (creating jobs, issuing printer commands, signed URLs).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL this app is deployed at (used in a few absolute-URL contexts).
APP_URL=http://localhost:3000

# Only needed when running `pnpm db:types` locally.
# SUPABASE_PROJECT_ID=your-project-ref
